{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wictorwilen/MRSF/raw/main/evaluation/reanchor/schema.json",
  "title": "MRSF reanchoring evaluation case",
  "type": "object",
  "required": ["id", "categories", "source", "target", "comments"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "source": {
      "$ref": "#/$defs/document"
    },
    "target": {
      "$ref": "#/$defs/document"
    },
    "comments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comment"
      }
    }
  },
  "$defs": {
    "document": {
      "oneOf": [
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 0
        },
        "end_column": {
          "type": "integer",
          "minimum": 0
        },
        "selected_text": {
          "type": "string",
          "maxLength": 4096
        },
        "selected_text_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commit": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["line"]
        },
        {
          "required": ["selected_text"]
        }
      ]
    },
    "range": {
      "type": "object",
      "required": ["line"],
      "additionalProperties": false,
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 0
        },
        "end_column": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "expected": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["anchored", "shifted", "fuzzy", "ambiguous", "orphaned"]
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/range"
          }
        },
        "rationale": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["anchored", "shifted", "fuzzy"]
              }
            }
          },
          "then": {
            "required": ["ranges"]
          }
        }
      ]
    },
    "comment": {
      "type": "object",
      "required": ["id", "anchor", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
